# PhishLens Backend Configuration
PROJECT_NAME="PhishLens API"
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
# In development, SQLite is used automatically if Postgres is not running.
DATABASE_URL=sqlite:///./phishlens.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://phishlens:phishlens@localhost:5432/phishlens
POSTGRES_USER=phishlens
POSTGRES_PASSWORD=phishlens
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phishlens

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
